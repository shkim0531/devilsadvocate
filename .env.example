# Anthropic 콘솔(https://console.anthropic.com)에서 발급한 API 키
ANTHROPIC_API_KEY=

# --- 아래는 필요할 때만 바꾸세요 ---
# 사용할 모델 (기본: claude-opus-5-5)
# DA_MODEL=claude-opus-5-5
# 반론 사이 최소 간격(초)
# DA_MIN_INTERVAL=30
# 말이 멈췄다고 보는 침묵 길이(초)
# DA_PAUSE_SECONDS=2.5
# 생각 깊이: low / medium / high / xhigh / max
# DA_LIVE_EFFORT=medium
# DA_REPORT_EFFORT=high
# 1로 하면 Claude를 부르지 않고 가짜 응답으로 화면만 확인
# DA_FAKE_LLM=0
